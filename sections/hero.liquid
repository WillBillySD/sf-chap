<section class="container hero section">
  <p style="margin:0;color:var(--color-primary);font-weight:700;">{{ section.settings.eyebrow }}</p>
  <h1>{{ section.settings.heading }}</h1>
  <div>{{ section.settings.copy }}</div>
  <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1rem;">
    {% if section.settings.primary_link != blank %}
      <a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
    {% endif %}
    {% if section.settings.secondary_link != blank %}
      <a class="button button--outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
    {% endif %}
  </div>

  {% for block in section.blocks %}
    {% render block %}
  {% endfor %}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Built to match mattgagedigital.com"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "A conversion-first Shopify storefront with Matt Gage Digital energy"},
    {"type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Use this theme foundation for service products, retainers, and digital offerings. The design uses warm neutrals, gold accent tones, and editorial spacing modeled after your existing brand personality.</p>"},
    {"type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop offers"},
    {"type": "url", "id": "primary_link", "label": "Primary button link"},
    {"type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "View services"},
    {"type": "url", "id": "secondary_link", "label": "Secondary button link"}
  ],
  "blocks": [{"type": "@app"}],
  "presets": [{"name": "Hero"}]
}
{% endschema %}
